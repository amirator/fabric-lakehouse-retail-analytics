table fact_orders
	lineageTag: 82eae034-0c70-e479-7324-27ccaaae40f8

	measure 'Orders' = COUNTROWS ( fact_orders )
		formatString: #,0
		lineageTag: 51bbe891-7ce6-4bce-ca03-68f4224d88fb

	measure 'Delivered Orders' = SUM ( fact_orders[is_delivered] )
		formatString: #,0
		lineageTag: eb385574-71f0-bc28-4ac7-4d22e735458f

	measure 'GMV' = CALCULATE ( SUM ( fact_orders[items_value] ), fact_orders[is_delivered] = 1 )
		formatString: "R$" #,0.00
		lineageTag: 60e2dc56-ec78-ff9f-260a-23cc0770f0cb

	measure 'AOV' = DIVIDE ( [GMV], [Delivered Orders] )
		formatString: "R$" #,0.00
		lineageTag: 9e7b06fd-f9d6-a31e-387a-730cc4876589

	measure 'Freight' = CALCULATE ( SUM ( fact_orders[freight_value] ), fact_orders[is_delivered] = 1 )
		formatString: "R$" #,0.00
		lineageTag: 21f9f5c9-e053-5097-7b6c-97b3339613ca

	measure 'Late Delivery %' = CALCULATE ( AVERAGE ( fact_orders[is_late] ), fact_orders[is_delivered] = 1 )
		formatString: 0.00%
		lineageTag: 09745eb3-283c-9631-b9f9-e9ca3f59a1b9

	measure 'Avg Delivery Days' = CALCULATE ( AVERAGE ( fact_orders[delivery_days] ), fact_orders[is_delivered] = 1 )
		formatString: 0.0
		lineageTag: d1571823-1b95-abeb-2dd7-0c7c6b118512

	measure 'Avg Review Score' = CALCULATE ( AVERAGE ( fact_orders[review_score] ), fact_orders[is_delivered] = 1 )
		formatString: 0.00
		lineageTag: 2478b15e-afce-0009-7d94-0509f03c5e81

	measure 'Item GMV' = CALCULATE ( SUM ( fact_order_items[price] ), fact_order_items[order_status] = "delivered" )
		formatString: "R$" #,0.00
		lineageTag: 19d8eb0f-0660-c0ee-06d7-17d643c9dc5f

	measure 'GMV PY' = CALCULATE ( [GMV], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: "R$" #,0.00
		lineageTag: a7b103b7-90a0-b3b5-a7da-0583ccd5382e

	measure 'GMV YoY %' = DIVIDE ( [GMV] - [GMV PY], [GMV PY] )
		formatString: 0.0%
		lineageTag: 6bae1278-bd25-7410-ea53-7da145b5b45c

	measure 'Customers' = DISTINCTCOUNT ( dim_customer[customer_unique_id] )
		formatString: #,0
		lineageTag: 84b7b00e-491f-4b6a-2bd2-fbdbef84a172

